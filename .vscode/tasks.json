{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve Project Pulse Dashboard",
      "type": "shell",
      "command": "python3 -m http.server 5500",
      "options": { "cwd": "${workspaceFolder}/app" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "project-pulse-server",
        "pattern": { "regexp": ".*" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Serving HTTP",
          "endsPattern": "Serving HTTP"
        }
      }
    },
    {
      "label": "Open Copilot CLI exercise terminal",
      "type": "shell",
      "command": "bash .devcontainer/postStart.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "new",
        "clear": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
