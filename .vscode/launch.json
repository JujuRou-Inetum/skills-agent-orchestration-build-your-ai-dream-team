{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Project Pulse Dashboard",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5500/index.html",
      "webRoot": "${workspaceFolder}/app",
      "runtimeArgs": ["--disable-extensions"],
      "preLaunchTask": "Serve Project Pulse Dashboard",
      "serverReadyAction": { "action": "openExternally", "pattern": "serving at (https?://localhost:5500)", "uriFormat": "http://localhost:%s/index.html" }
    }
  ]
}